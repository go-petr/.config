{
  "title": "Right-Cmd app launcher",
  "rules": [
    {
      "description": "Right-Cmd+U: Claude",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "u",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'Claude'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+I: Brave Browser",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'Brave Browser'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+O: ChatGPT",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "o",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'ChatGPT'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+P: Telegram",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "p",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'Telegram'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+H: WezTerm",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'WezTerm'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+K: VS Code",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'Visual Studio Code'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+D: Open Downloads folder",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open ~/Downloads" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+N: Notion",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "n",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'Notion'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+J: Device Hub",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a '/Applications/Xcode.app/Contents/Applications/DeviceHub.app'" }]
        }
      ]
    },
    {
      "description": "Right-Cmd+[: Zoom",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "open_bracket",
            "modifiers": { "mandatory": ["right_command"] }
          },
          "to": [{ "shell_command": "open -a 'zoom.us'" }]
        }
      ]
    }
  ]
}
